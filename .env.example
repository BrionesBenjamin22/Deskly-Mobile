# Variables consumidas por docker-compose.dev.yml.
# Copiar este archivo como .env en la raiz. El archivo .env real esta ignorado.

# Password local del usuario PostgreSQL "deskly". No reutilizar en produccion.
POSTGRES_PASSWORD=replace_with_a_strong_local_password

# URL publica que Expo usara para llamar al backend.
# Web en el mismo host: http://127.0.0.1:3000
# Android Emulator: http://10.0.2.2:3000
# Dispositivo fisico: http://IP_LAN_DEL_HOST:3000
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_APP_ENV=development
