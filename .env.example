# Copiar como .env en la raiz. No versionar valores reales.
POSTGRES_PASSWORD=replace_with_a_local_password

# Docker publica el backend en la LAN para Expo Go. Reemplazar por la IP LAN
# real del host; 127.0.0.1 no funciona desde un telefono.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
EXPO_PUBLIC_APP_ENV=development
