NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deskly?schema=public"

JWT_SECRET=change_me_for_local_development
JWT_EXPIRES_IN=1h

# Use FAKE for local development and automated tests.
PAYMENT_GATEWAY=FAKE
# Required only when PAYMENT_GATEWAY=MERCADO_PAGO. Never commit real secrets.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=https://deskly.example/payments/success
MERCADO_PAGO_FAILURE_URL=https://deskly.example/payments/failure
MERCADO_PAGO_PENDING_URL=https://deskly.example/payments/pending
MERCADO_PAGO_ALLOWED_RETURN_ORIGINS=https://deskly.example
MERCADO_PAGO_TIMEOUT_MS=5000
