# Template documental. Inyectar estos valores desde el gestor de secretos de la
# plataforma; no crear ni versionar backend/.env.production con valores reales.
NODE_ENV=production
PORT=3000
# Origenes HTTPS separados por coma.
FRONTEND_URL=https://app.example.com

# Incluir ?schema=public cuando corresponda.
DATABASE_URL=

# Secreto aleatorio de 32 caracteres o mas, sin placeholders.
JWT_SECRET=
# Formato Ns/Nm/Nh/Nd; maximo 7 dias.
JWT_EXPIRES_IN=1h
# Secreto independiente del access token.
JWT_REFRESH_SECRET=
# Formato Ns/Nm/Nh/Nd; maximo 30 dias.
JWT_REFRESH_EXPIRES_IN=30d

# Inyectar temporalmente durante el bootstrap y retirar al finalizar.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

PAYMENT_GATEWAY=MERCADO_PAGO
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=https://app.example.com/payments/return/success
MERCADO_PAGO_FAILURE_URL=https://app.example.com/payments/return/failure
MERCADO_PAGO_PENDING_URL=https://app.example.com/payments/return/pending
MERCADO_PAGO_NOTIFICATION_URL=https://api.example.com/webhooks/payments?source_news=webhooks
# Origenes HTTPS separados por coma. Deben cubrir las tres URLs anteriores.
MERCADO_PAGO_ALLOWED_RETURN_ORIGINS=https://app.example.com
MERCADO_PAGO_ALLOWED_NOTIFICATION_ORIGINS=https://api.example.com
# Entero entre 500 y 30000 milisegundos.
MERCADO_PAGO_TIMEOUT_MS=5000

# Habilitar solo en una instancia lider. Con multiples replicas, usar un
# scheduler externo autenticado contra POST /payments/operations/reconcile.
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_LIMIT=50
PAYMENT_RECONCILIATION_MIN_AGE_MINUTES=5
