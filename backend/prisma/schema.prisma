// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum DeskZone {
  A
  B
  C
}

enum UserRole {
  ADMIN
  GESTOR
  MIEMBRO
}

enum PenaltyType {
  ABSENCE
  LATE_CANCELLATION
}

enum InfractionLevel {
  WARNING
  PENALTY
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String            @unique @db.VarChar(255)
  username            String            @unique @db.VarChar(60)
  passwordHash        String            @map("password_hash") @db.VarChar(255)
  role                UserRole          @default(MIEMBRO)
  active              Boolean           @default(true)
  blockedUntil        DateTime?         @map("blocked_until")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  member              Member?
  roleChanges         UserRoleHistory[] @relation("RoleChangeTarget")
  changedRoles        UserRoleHistory[] @relation("RoleChangeActor")
  registeredPenalties Penalty[]         @relation("PenaltyRegistrar")

  @@index([active])
  @@map("users")
}

model Member {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @unique @map("user_id") @db.Uuid
  fullName     String        @map("full_name") @db.VarChar(200)
  dni          Int           @unique
  phone        BigInt
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  reservations Reservation[]
  penalties    Penalty[]

  @@index([active])
  @@map("members")
}

model UserRoleHistory {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  changedById  String   @map("changed_by_id") @db.Uuid
  previousRole UserRole @map("previous_role")
  newRole      UserRole @map("new_role")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation("RoleChangeTarget", fields: [userId], references: [id], onDelete: Restrict)
  changedBy    User     @relation("RoleChangeActor", fields: [changedById], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([changedById])
  @@map("user_role_history")
}

model Desk {
  id             String           @id @default(uuid()) @db.Uuid
  code           String           @unique @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(36)
  name           String?          @db.VarChar(120)
  peopleCapacity Int              @default(1) @map("people_capacity")
  descriptionId  String?          @map("description_id") @db.Uuid
  zone           DeskZone?
  enabled        Boolean          @default(true)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  deletedAt      DateTime?        @map("deleted_at")
  description    DeskDescription? @relation(fields: [descriptionId], references: [id], onDelete: Restrict)
  amenities      DeskAmenity[]
  reservations   Reservation[]

  @@index([enabled, deletedAt])
  @@index([descriptionId])
  @@index([zone])
  @@map("desks")
}

model DeskDescription {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique @db.VarChar(120)
  description    String?  @db.VarChar(255)
  peopleCapacity Int      @map("people_capacity")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  desks          Desk[]

  @@map("desk_descriptions")
}

model Amenity {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(120)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  desks     DeskAmenity[]

  @@map("amenities")
}

model DeskAmenity {
  deskId    String   @map("desk_id") @db.Uuid
  amenityId String   @map("amenity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  desk      Desk     @relation(fields: [deskId], references: [id], onDelete: Cascade)
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([deskId, amenityId])
  @@index([amenityId])
  @@map("desk_amenities")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  deskId      String            @map("desk_id") @db.Uuid
  memberId    String            @map("member_id") @db.Uuid
  date        DateTime          @db.Date
  startTime   DateTime          @map("start_time") @db.Time(0)
  endTime     DateTime          @map("end_time") @db.Time(0)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  cancelledAt DateTime?         @map("cancelled_at")
  checkedInAt  DateTime?         @map("checked_in_at")
  desk        Desk              @relation(fields: [deskId], references: [id], onDelete: Restrict)
  payments    Payment[]
  member      Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  penalty     Penalty?

  @@index([deskId, date, status, startTime, endTime])
  @@index([memberId, date])
  @@map("reservations")
}

model Penalty {
  id             String          @id @default(uuid()) @db.Uuid
  reservationId  String          @unique @map("reservation_id") @db.Uuid
  memberId       String          @map("member_id") @db.Uuid
  registeredById String?         @map("registered_by_id") @db.Uuid
  type           PenaltyType
  level          InfractionLevel
  reason         String          @db.VarChar(500)
  registeredAt   DateTime        @default(now()) @map("registered_at")
  activeUntil    DateTime        @map("active_until")
  createdAt      DateTime        @default(now()) @map("created_at")
  reservation    Reservation     @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  member         Member          @relation(fields: [memberId], references: [id], onDelete: Restrict)
  registeredBy   User?           @relation("PenaltyRegistrar", fields: [registeredById], references: [id], onDelete: Restrict)

  @@index([memberId, activeUntil, level])
  @@index([registeredById])
  @@map("penalties")
}

model Payment {
  id            String      @id @default(uuid()) @db.Uuid
  reservationId String      @map("reservation_id") @db.Uuid
  date          DateTime    @map("payment_date") @db.Date
  amount        Float
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([date])
  @@map("payments")
}
