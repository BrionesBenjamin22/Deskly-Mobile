// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ReservationStatus {
  ACTIVE
  CANCELLED
}

enum DeskZone {
  A
  B
  C
}

model Desk {
  id            String           @id @default(uuid()) @db.Uuid
  code          String           @unique @default(dbgenerated("gen_random_uuid()::text")) @db.VarChar(36)
  name          String?          @db.VarChar(120)
  peopleCapacity Int              @default(1) @map("people_capacity")
  descriptionId String?          @map("description_id") @db.Uuid
  zone          DeskZone?
  enabled       Boolean          @default(true)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  deletedAt     DateTime?        @map("deleted_at")
  description   DeskDescription? @relation(fields: [descriptionId], references: [id], onDelete: Restrict)
  amenities     DeskAmenity[]
  reservations  Reservation[]

  @@index([enabled, deletedAt])
  @@index([descriptionId])
  @@index([zone])
  @@map("desks")
}

model DeskDescription {
  id             String   @id @default(uuid()) @db.Uuid
  name           String   @unique @db.VarChar(120)
  description    String?  @db.VarChar(255)
  peopleCapacity Int      @map("people_capacity")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  desks          Desk[]

  @@map("desk_descriptions")
}

model Amenity {
  id        String        @id @default(uuid()) @db.Uuid
  name      String        @unique @db.VarChar(120)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  desks     DeskAmenity[]

  @@map("amenities")
}

model DeskAmenity {
  deskId    String   @map("desk_id") @db.Uuid
  amenityId String   @map("amenity_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  desk      Desk     @relation(fields: [deskId], references: [id], onDelete: Cascade)
  amenity   Amenity  @relation(fields: [amenityId], references: [id], onDelete: Restrict)

  @@id([deskId, amenityId])
  @@index([amenityId])
  @@map("desk_amenities")
}

model Reservation {
  id          String            @id @default(uuid()) @db.Uuid
  deskId      String            @map("desk_id") @db.Uuid
  date        DateTime          @db.Date
  startTime   DateTime          @map("start_time") @db.Time(0)
  endTime     DateTime          @map("end_time") @db.Time(0)
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  cancelledAt DateTime?         @map("cancelled_at")
  desk        Desk              @relation(fields: [deskId], references: [id], onDelete: Restrict)
  payments    Payment[]

  @@index([deskId, date, status, startTime, endTime])
  @@map("reservations")
}

model Payment {
  id            String   @id @default(uuid()) @db.Uuid
  reservationId String   @map("reservation_id") @db.Uuid
  date          DateTime @map("payment_date") @db.Date
  amount        Float
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([reservationId])
  @@index([date])
  @@map("payments")
}
