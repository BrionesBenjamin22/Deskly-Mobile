# Copiar como .env.development. Este archivo real esta ignorado.
NODE_ENV=development
PORT=3000
# Origenes CORS separados por coma, sin rutas.
FRONTEND_URL=http://localhost:8081

# PostgreSQL local cuando el backend se ejecuta fuera de Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deskly?schema=public"

# Generar un valor aleatorio de 32 caracteres o mas. No usar este placeholder.
JWT_SECRET=change_me_with_a_random_local_secret_of_at_least_32_chars
# Formatos permitidos: Ns, Nm, Nh o Nd. Maximo 7 dias.
JWT_EXPIRES_IN=1h
# Usar un secreto aleatorio diferente de JWT_SECRET.
JWT_REFRESH_SECRET=change_me_with_a_different_random_secret_of_at_least_32_chars
# Formatos permitidos: Ns, Nm, Nh o Nd. Maximo 30 dias.
JWT_REFRESH_EXPIRES_IN=30d

# Solo para `pnpm admin:bootstrap`. La password debe tener 12-72 caracteres,
# mayuscula, minuscula y numero. Eliminar los valores despues de usarlo.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# FAKE no necesita red ni credenciales y es el valor recomendado para desarrollo.
PAYMENT_GATEWAY=FAKE
# Solo obligatorias cuando PAYMENT_GATEWAY=MERCADO_PAGO.
# Token minimo 20 caracteres; webhook secret minimo 16.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
# Las tres URLs deben pertenecer a uno de los origenes permitidos.
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=
# URL HTTPS publica del backend. La ruta debe ser /webhooks/payments y conservar
# source_news=webhooks.
MERCADO_PAGO_NOTIFICATION_URL=
# Lista de origenes separada por coma, por ejemplo http://localhost:8081.
MERCADO_PAGO_ALLOWED_RETURN_ORIGINS=
# Origenes HTTPS autorizados para notification_url, separados por coma.
MERCADO_PAGO_ALLOWED_NOTIFICATION_ORIGINS=
# Entero entre 500 y 30000 milisegundos.
MERCADO_PAGO_TIMEOUT_MS=5000

# Conciliacion automatica. Mantener deshabilitada si un scheduler externo llama
# POST /payments/operations/reconcile.
PAYMENT_RECONCILIATION_ENABLED=false
PAYMENT_RECONCILIATION_INTERVAL_MS=60000
PAYMENT_RECONCILIATION_LIMIT=50
PAYMENT_RECONCILIATION_MIN_AGE_MINUTES=5
