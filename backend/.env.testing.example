NODE_ENV=test
PORT=3001
FRONTEND_URL=http://localhost:8081

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/deskly_test?schema=public"

JWT_SECRET=deterministic_test_secret_not_for_production
JWT_EXPIRES_IN=1h

# Solo para pruebas explicitas del bootstrap administrativo.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

PAYMENT_GATEWAY=FAKE

# No son requeridas mientras PAYMENT_GATEWAY=FAKE. Se incluyen para mantener
# el mismo contrato entre entornos y permitir pruebas sandbox explicitas.
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_SUCCESS_URL=
MERCADO_PAGO_FAILURE_URL=
MERCADO_PAGO_PENDING_URL=
MERCADO_PAGO_ALLOWED_RETURN_ORIGINS=
MERCADO_PAGO_TIMEOUT_MS=5000
